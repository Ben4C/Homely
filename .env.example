# Never put production credentials or personal data in this file.
NEXT_PUBLIC_SITE_NAME=Homely
API_INTERNAL_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://homely:homely_dev_only@localhost:5432/homely
REGISTRY_MODE=database
REGISTRY_REVERIFY_DAYS=30
# Server-only SHA256(token) -> {actor_id, role, organization_ids}. Empty denies all reviewers.
HOMELY_REVIEWERS_JSON={}
# Optional separate database for integration tests; name must end _test.
# TEST_DATABASE_URL=postgresql+psycopg://homely:homely_dev_only@localhost:5432/homely_test
DEMO_MODE=true

# Claude server-side only. NEVER prefix secrets with NEXT_PUBLIC_.
# Copy to an untracked local .env and load into the backend process.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
